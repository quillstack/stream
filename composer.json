{
    "name": "quillstack/stream",
    "description": "The simple implementation of PSR-7: StreamInterface.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://quillstack.org/packages/stream",
    "keywords": [
        "stream",
        "input",
        "php-input",
        "php",
        "php8",
        "psr-7",
        "stream-interface",
        "psr"
    ],
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^1.0|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\Stream\\": "src/",
            "Quillstack\\Stream\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
